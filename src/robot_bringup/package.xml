<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.0.0</version>
  <description>Come si avvia il robot: i launch file e la disposizione di RViz</description>
  <maintainer email="145957795+Luca40mx@users.noreply.github.com">Luca40mx</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Serve a tempo di esecuzione ai launch file. -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Dove stanno i file YAML che i launch passano ai nodi. -->
  <exec_depend>robot_config</exec_depend>

  <!-- Il modello del braccio, che display.launch.py legge. -->
  <exec_depend>robot_description</exec_depend>

  <!-- I nodi che questi launch avviano. Una riga per ogni nodo nuovo. -->
  <exec_depend>arduino_ros_bridge</exec_depend>
  <exec_depend>robot_homing</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
